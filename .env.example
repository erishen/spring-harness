# ============================================
# Spring AI Alibaba (DashScope) 配置模板
# ============================================
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env
# .env 已加入 .gitignore，不会提交密钥。

# 阿里云百炼 API Key
# 获取地址：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-your-api-key-here

# 模型名称
# 常用：qwen-turbo / qwen-plus / qwen-max / qwen3-coder-plus / glm-5.2
DASHSCOPE_MODEL=qwen-plus

# 最大输出 token 数（控制回答长度，代码生成建议 4096+）
MAX_TOKENS=4096

# RAG 向量模型（文档向量化）
# 可选：qwen3.7-text-embedding / text-embedding-v2 / text-embedding-v3
EMBEDDING_MODEL=qwen3.7-text-embedding

# RAG 重排序模型（检索后精排）
# 可选：qwen3.7-text-rerank
RERANK_MODEL=qwen3.7-text-rerank

# 可选：业务空间 ID，不配置时使用主账号空间
# DASHSCOPE_WORKSPACE_ID=

# 服务端口
SERVER_PORT=8080

# Alpha Vantage API Key（Agent 模式的股票查询工具需要）
# 免费获取：https://www.alphavantage.co/support/#api-key
# 免费额度：5 次/分钟，500 次/天
ALPHAVANTAGE_API_KEY=your-alpha-vantage-key

# Finnhub API Key（股票实时行情工具备选数据源，Yahoo Finance 被 429 限流时兜底）
# 免费获取：https://finnhub.io/register
FINNHUB_API_KEY=your-finnhub-key

# Agnes AI（OpenAI 兼容 API，推理模型）
# 免费注册：https://apihub.agnes-ai.com
AGNES_API_KEY=sk-your-agnes-key-here
# Agnes 兼容端点 Base URL（不带 /v1，SDK 会自动拼接）
AGNES_BASE_URL=https://apihub.agnes-ai.com

# MCP（Model Context Protocol）工具开关
# 启用后，连接的 MCP 服务器工具会自动被 Planner/Specialist 使用
# 需在 application.yml 的 spring.ai.mcp.client 下配置 MCP 服务器连接
MCP_ENABLED=false

# MCP 文件系统服务器可执行文件路径（默认 ~/.npm-global/bin/mcp-server-filesystem）
# 全局安装：npm i -g @modelcontextprotocol/server-filesystem
# MCP_FS_COMMAND=/absolute/path/to/mcp-server-filesystem
# MCP 文件系统服务器允许访问的目录（默认为项目根目录）
MCP_FS_DIR=./
# resolve-skills 项目根目录（weekly-investment 技能脚本 + souls 所在仓库；默认 ../../harness/resolve-skills）
# RESOLVE_SKILLS_DIR=/absolute/path/to/work/harness/resolve-skills

# ============================================
# Docker 代码沙箱配置
# ============================================
# 启用代码执行工具（execute_code），Agent 可在 Docker 容器中执行 Python/JavaScript/Shell/Java/Go/Rust/C/C++
# 需先启动 Docker（OrbStack / Docker Desktop）
SANDBOX_ENABLED=true

# 代码执行超时时间（秒），超时后容器自动强制终止
SANDBOX_TIMEOUT=30

# 容器内存限制（MB）
SANDBOX_MEMORY_MB=512

# 容器 CPU 限制（核数）
SANDBOX_CPUS=1

# 标准输出/错误最大大小（KB），超过自动截断
SANDBOX_MAX_OUTPUT_KB=100

# ============================================
# Agent Skills（技能包）配置
# ============================================
# 技能目录路径，对齐 Agent Skills 开放标准
# 每个技能目录包含 SKILL.md，AI 通过 skill_run 工具加载技能完整指令
# resolve-skills 作为 git submodule 管理，相对路径指向 submodule 的 skills/ 目录
HARNESS_SKILLS_DIR=resolve-skills/skills
# PSE 各 Agent 角色定义（Soul）目录：每个角色子目录下有 SOUL.md
# souls 不入 resolve-skills 仓库（gitignore），使用本地 work/harness/resolve-skills 下的真实 souls
# HARNESS_SOULS_DIR=/absolute/path/to/work/harness/resolve-skills/souls
# SQLite 任务数据库路径（重启后自动恢复历史任务）
TASK_DB_PATH=data/tasks.db

# 长时任务线程池大小（并发执行的最大任务数）
TASK_POOL_SIZE=4

# 长时任务执行日志目录
TASK_LOG_DIR=logs/tasks

# Agnes 免费 API 限流配置（控制调用频率，避免 429 限流）
AGNES_RATE_INTERVAL_MS=6000
AGNES_RATE_MAX_RETRIES=3
AGNES_RATE_BACKOFF_BASE_MS=10000
AGNES_MAX_TOKENS=8192

# ============================================
# 上下文压缩（Context Compression）配置
# ============================================
# 启用 LLM 语义摘要折叠（默认关闭）
# 关闭：零成本的轻量折叠（保留工具名+参数+结论骨架）
# 开启：上下文超限时用 LLM 把最旧的工具往返压缩成语义摘要（更智能，
#       但每次裁剪多消耗一次 LLM 调用，并在 agnes 限流下更慢）
CONTEXT_SUMMARY_ENABLED=false
# LLM 语义摘要的最大字符数（超出截断）
CONTEXT_SUMMARY_MAX_CHARS=4000

# ============================================
# 投资数据管线（weekly-investment 技能依赖 portfolio-check / pse-review MCP 桥）
# ============================================
# autogen-pse 项目路径（数据快照 + PSE 周报管线）
AUTOGEN_PSE_DIR=/path/to/your/frameworks/autogen-pse
# pse-review 默认模型来源：agnes（免费，默认）/ deepseek（付费、稳定）
PSE_REVIEW_PROVIDER=agnes
# 周报产物副本落盘目录（resolve-studio 的 sandbox，供 Web UI 预览；可选）
RESOLVE_STUDIO_DIR=/path/to/your/work/harness/resolve-studio
# PSE 编排整体超时（秒）：pse-review 等长工具单次 2-6 分钟，需足够余量
PSE_TIMEOUT_SECONDS=600
# PSE 子任务是否并行执行
PSE_PARALLEL_ENABLED=true

# ============================================
# 长期记忆（Memory）
# ============================================
# 是否启用长期记忆：从对话抽取用户偏好/事实，跨会话注入各模式
MEMORY_ENABLED=true
# 是否启用记忆抽取（命中信号词才调 LLM，控制成本）
MEMORY_EXTRACT_ENABLED=true
# 每次注入 System prompt 的记忆条数
MEMORY_TOP_K=5
# 记忆条目上限（超出删除最旧）
MEMORY_MAX_ITEMS=200
# 记忆抽取模型（留空跟随主模型）
MEMORY_MODEL=
# 会话窗口记忆（方案 B）：按 conversationId 后端维护多轮窗口，默认关闭
MEMORY_CHAT_ENABLED=false
# 会话窗口大小
MEMORY_CHAT_WINDOW=20
